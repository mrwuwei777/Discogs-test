# Discogs personal access token: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Optional: your Discogs username. If omitted, it's looked up automatically
# from the token via /oauth/identity.
DISCOGS_USERNAME=

# Google Gemini API key, free tier (for reading the record cover/label from
# the photo when no barcode is found): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-flash-latest,
# Google's alias that always points at their current recommended Flash model)
GEMINI_MODEL=
