# Discogs personal access token: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Optional: your Discogs username. If omitted, it's looked up automatically
# from the token via /oauth/identity.
DISCOGS_USERNAME=

# Google Gemini API key, free tier (for reading the record cover/label from
# the photo when no barcode is found): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-3.6-flash).
# The "-latest" alias names have proven unreliable (they can silently
# resolve to a deprecated model), so this is pinned to a real model name.
# If it's ever retired, list what your key can access at:
# https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
GEMINI_MODEL=
