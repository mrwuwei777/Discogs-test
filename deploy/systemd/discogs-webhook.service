[Unit]
Description=Discogs Photo Collector deploy webhook listener
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/Discogs-test
EnvironmentFile=/home/deploy/Discogs-test/deploy/webhook.env
ExecStart=/usr/bin/node /home/deploy/Discogs-test/deploy/webhook-listener.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
