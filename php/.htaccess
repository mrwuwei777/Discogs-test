# The parent WordPress .htaccess only rewrites requests that are not real files
# or directories, so this app is served directly. These rules make that explicit
# and independent of whatever WordPress writes above.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /discogs/

  # PHP-FPM does not see Basic auth credentials unless the header is forwarded.
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Real files and directories are served as-is; nothing else is rewritten.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Belt and braces: never serve config or dotfiles even if one is ever placed here.
<FilesMatch "^(config\.php|config\.sample\.php|\.env.*)$">
  Require all denied
</FilesMatch>

# The app mutates a real collection — keep it out of search engines and the CDN.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "no-store, no-cache, must-revalidate"
</IfModule>

# Static assets are fingerprinted with ?v=, so they can cache hard.
<FilesMatch "\.(css|js)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
  </IfModule>
</FilesMatch>
